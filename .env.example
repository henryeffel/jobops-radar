APP_NAME=JobOps Radar
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false

# Local development fallback (works without Docker)
DATABASE_URL=sqlite:///./jobops.db

# PostgreSQL production target (also used by docker-compose.yml)
# DATABASE_URL=postgresql+psycopg://jobops:jobops@localhost:5432/jobops

# Local-only value; replace with a secret of at least 32 random bytes.
JWT_SECRET_KEY=local-only-change-me-32-bytes-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Per-process Argon2 verification limit and maximum queue wait.
AUTH_VERIFY_MAX_CONCURRENCY=2
AUTH_VERIFY_WAIT_TIMEOUT_SECONDS=3
SARAMIN_ACCESS_KEY=
SARAMIN_API_BASE_URL=https://oapi.saramin.co.kr
LLM_API_KEY=
LLM_MOCK_MODE=true
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_TIMEOUT_SECONDS=50
LLM_MAX_INPUT_CHARS=30000
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_CONCURRENCY=2
LLM_WAIT_TIMEOUT_SECONDS=1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
